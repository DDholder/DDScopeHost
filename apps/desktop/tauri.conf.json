{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDScopeHost",
  "version": "0.1.0",
  "identifier": "com.ddscope.host",
  "build": {
    "beforeDevCommand": "pnpm --filter @ddscope/web-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ddscope/web-ui build",
    "frontendDist": "../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DDScopeHost",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
